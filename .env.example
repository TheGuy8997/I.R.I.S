# Music Assistant server URL, long-lived token, and target player ID.
MUSIC_ASSISTANT_URL="http://localhost:8095"
MUSIC_ASSISTANT_TOKEN=""
MUSIC_ASSISTANT_PLAYER_ID=""

# Webz.io News API token. Leave blank to disable news requests.
WEBZ_API_TOKEN=""

# Local device and model configuration.
IRIS_VOSK_MODEL_PATH="models/vosk"
IRIS_WAKE_WORD="iris"
IRIS_MIC_DEVICE="ZTD39 Device"
IRIS_MIC_SAMPLE_RATE="48000"
IRIS_AUDIO_BLOCKSIZE="9600"
IRIS_PIPER_VOICE="en_US-ryan-medium.onnx"
IRIS_ALSA_DEVICE="plughw:CARD=Device,DEV=0"
IRIS_PIPER_SAMPLE_RATE="22050"
IRIS_OLLAMA_MODEL="iris"
IRIS_OLLAMA_KEEP_ALIVE="10m"
